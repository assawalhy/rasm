{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@stores/*": ["./src/stores/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "allowJs": true,
    "jsx": "preserve"
  },
  "include": ["**/*.ts", "**/*.js", "**/*.tsx", "**/*.jsx", "../math/src/tex2max.js"],
  "exclude": ["node_modules", "public", "dist"]
}
